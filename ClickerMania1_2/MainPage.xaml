<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ClickerMania1_2.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Lime">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="14"
            VerticalOptions="Center">

            <!-- Application title -->
            <Label
                Text="Clicker Mania 1.2"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="Black"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,20" />

            <!-- Timer -->
            <Label
                Text="Timer"
                FontSize="23"
                TextColor="Black"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="TimerLabel"
                Text="0"
                FontSize="60"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <!-- Click counter -->
            <Label
                Text="Clicks"
                FontSize="23"
                TextColor="Black"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="ClicksLabel"
                Text="0"
                FontSize="60"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <!-- Clicks Per Minute -->
            <Label
                Text="Clicks Per Minute"
                FontSize="23"
                TextColor="Black"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="CpmLabel"
                Text="0.00"
                FontSize="60"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <!-- Click button -->
            <Button
                x:Name="ClickButton"
                Text="Click"
                FontSize="32"
                Padding="50,12"
                HorizontalOptions="Center"
                BackgroundColor="#512BD4"
                TextColor="White"
                Margin="0,20,0,0"
                Clicked="OnClickButtonClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
