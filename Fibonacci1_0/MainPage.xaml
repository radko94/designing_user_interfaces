<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Fibonacci1_0.MainPage"
    BackgroundColor="Pink">

    <Grid
        Padding="25"
        RowSpacing="12"
        RowDefinitions="Auto,Auto,Auto,*">

        <!-- Application title -->
        <Label
            Grid.Row="0"
            Text="Fibonacci 1.0"
            FontSize="36"
            TextColor="Black" />

        <!-- Numeric limit -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <Label
                Text="Limit"
                FontSize="20"
                TextColor="Black" />

            <Entry
                x:Name="boxLimit"
                Text="1000"
                Keyboard="Numeric"
                FontSize="20"
                TextColor="Black"
                BackgroundColor="White" />

        </VerticalStackLayout>

        <!-- Generate button -->
        <Button
            Grid.Row="2"
            Text="Generate"
            FontSize="20"
            Padding="20,10"
            Clicked="Button_Click" />

        <!-- Fibonacci numbers -->
        <CollectionView
            x:Name="boxNumbers"
            Grid.Row="3"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label
                        Text="{Binding .}"
                        FontSize="20"
                        TextColor="Black"
                        Padding="5,6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>