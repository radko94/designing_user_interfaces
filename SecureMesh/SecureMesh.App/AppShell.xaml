<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SecureMesh.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SecureMesh.App.Pages"
    Title="SecureMesh"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Идентичност"
        Route="identity"
        ContentTemplate="{DataTemplate pages:IdentityPage}" />

    <ShellContent
        Title="Контакти"
        Route="contacts"
        ContentTemplate="{DataTemplate pages:ContactsPage}" />

</Shell>
