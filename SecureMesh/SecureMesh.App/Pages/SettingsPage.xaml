<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureMesh.App.Pages.SettingsPage"
             Title="Настройки"
             BackgroundColor="{AppThemeBinding Light=#F4F6FA, Dark=#12141A}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="480">

            <Label Text="Настройки" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2430, Dark=#E7EAF0}" />

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1F27}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E2E6EE, Dark=#2A2F3A}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Реле (препредаване)" FontSize="16" TextColor="{AppThemeBinding Light=#1F2430, Dark=#E7EAF0}" />
                        <Label Text="Офлайн режим — директна Bluetooth връзка. Релето не е налично в тази версия."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA1AC}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="False" IsEnabled="False" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Text="Експортиране на данни"
                    Clicked="OnExportClicked"
                    FontSize="16"
                    BackgroundColor="#1B6EF3"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52" />

            <Button Text="Изтриване на локалните данни"
                    Clicked="OnDeleteClicked"
                    FontSize="16"
                    BackgroundColor="#DC2626"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
