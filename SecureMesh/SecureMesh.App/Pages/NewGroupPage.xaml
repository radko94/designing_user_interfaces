<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureMesh.App.Pages.NewGroupPage"
             Title="Нова група"
             BackgroundColor="{AppThemeBinding Light=#F4F6FA, Dark=#12141A}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,12" RowSpacing="8">

        <Label Grid.Row="0"
               Text="Име на групата"
               FontSize="13"
               TextColor="{AppThemeBinding Light=#333A45, Dark=#C7CDD8}" />

        <Border Grid.Row="1"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#D3D9E3, Dark=#2A2F3A}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1F27}"
                Padding="12,4"
                StrokeShape="RoundRectangle 12">
            <Entry x:Name="GroupNameEntry"
                   Placeholder="Например: Семейство"
                   FontSize="16"
                   ReturnType="Next" />
        </Border>

        <Label Grid.Row="2"
               Text="Изберете участници"
               FontSize="13"
               Margin="0,8,0,0"
               TextColor="{AppThemeBinding Light=#333A45, Dark=#C7CDD8}" />

        <CollectionView x:Name="ContactsView"
                        Grid.Row="3"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Няма контакти"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA1AC}" />
                    <Label Text="Добавете контакт, преди да създадете група."
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA1AC}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1F27}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E6EE, Dark=#2A2F3A}"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,10"
                            MinimumHeightRequest="48">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding Name}"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#1F2430, Dark=#E7EAF0}" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalOptions="Center"
                                      Color="#1B6EF3" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4"
                Text="Създай група"
                Clicked="OnCreateClicked"
                FontSize="16"
                BackgroundColor="#1B6EF3"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="52"
                Margin="0,8,0,0" />
    </Grid>
</ContentPage>
