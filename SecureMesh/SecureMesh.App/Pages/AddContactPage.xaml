<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="SecureMesh.App.Pages.AddContactPage"
             Title="Добави контакт"
             BackgroundColor="{AppThemeBinding Light=#F4F6FA, Dark=#12141A}">

    <Grid RowDefinitions="*,Auto" Padding="16,12">

        <Grid Grid.Row="0">
            <Border BackgroundColor="Black"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <zxing:CameraBarcodeReaderView x:Name="BarcodeView"
                                               IsDetecting="False"
                                               BarcodesDetected="OnBarcodesDetected" />
            </Border>

            <Label x:Name="StatusLabel"
                   Text="Насочете камерата към QR кода на другия потребител."
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="16"
                   Padding="12"
                   BackgroundColor="#CC000000"
                   TextColor="White" />
        </Grid>

        <Button Grid.Row="1"
                Text="Отказ"
                Clicked="OnCancelClicked"
                FontSize="16"
                BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2F3A}"
                TextColor="{AppThemeBinding Light=#1F2430, Dark=#E7EAF0}"
                CornerRadius="12"
                HeightRequest="52"
                Margin="0,8,0,0" />
    </Grid>
</ContentPage>
