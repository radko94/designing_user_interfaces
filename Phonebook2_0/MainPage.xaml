<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Phonebook2_0.Models"
    x:Class="Phonebook2_0.MainPage"
    Title="Phone Book 2.0"
    BackgroundColor="Cyan">

    <Grid
        Padding="20"
        RowSpacing="15"
        RowDefinitions="Auto,*,Auto">

        <!-- Application title -->
        <Label
            Grid.Row="0"
            Text="Phone Book 2.0"
            FontSize="34"
            TextColor="Black" />

        <!-- Contact list -->
        <CollectionView
            x:Name="boxContacts"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No contacts yet. Tap Add to create one."
                    FontSize="16"
                    TextColor="Black" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Contact">

                    <Grid
                        Padding="0,8"
                        ColumnDefinitions="80,*"
                        ColumnSpacing="12">

                        <!-- Contact picture -->
                        <Grid
                            Grid.Column="0"
                            WidthRequest="76"
                            HeightRequest="76">

                            <!-- Default placeholder image -->
                            <Image
                                Source="https://images.unsplash.com/photo-1740252117012-bb53ad05e370?ixid=M3w4MjcwNjd8MHwxfHNlYXJjaHw4fHxwbGFjZWhvbGRlciUyQyUyMHBlcnNvfHx8fDE3OTI4NjE5NzZ8MA&amp;ixlib=rb-4.1.0&amp;fit=max&amp;q=80"
                                Aspect="AspectFill" />

                            <!-- User-provided image -->
                            <Image
                                Source="{Binding PictureUrl}"
                                Aspect="AspectFill" />

                        </Grid>

                        <!-- Contact information -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="5">

                            <Label
                                Text="{Binding Name}"
                                FontSize="24"
                                TextColor="Black"
                                LineBreakMode="TailTruncation" />

                            <Label
                                Text="{Binding Phone}"
                                FontSize="18"
                                TextColor="Black" />

                        </VerticalStackLayout>

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add button -->
        <Button
            Grid.Row="2"
            Text="Add"
            FontSize="20"
            Padding="20,12"
            BackgroundColor="#512BD4"
            TextColor="White"
            Clicked="OnAddClicked" />

    </Grid>

</ContentPage>
