<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Suma2_0.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Title -->
            <Label Text="Suma 2.0"
                   FontSize="32" />

            <!-- First number -->
            <Label Text="A=" />
            <Entry x:Name="boxA"
                   Keyboard="Numeric"
                   Placeholder="Enter A" />

            <!-- Second number -->
            <Label Text="B=" />
            <Entry x:Name="boxB"
                   Keyboard="Numeric"
                   Placeholder="Enter B" />

            <!-- Result -->
            <Label Text="A+B=" />
            <Entry x:Name="boxAB"
                   Keyboard="Numeric"
                   IsReadOnly="True" />

            <!-- Calculate -->
            <Button Text="Sum"
                    Margin="0,20,0,0"
                    Clicked="OnButtonClicked" />

            <!-- Validation message -->
            <Label x:Name="errorLabel"
                   TextColor="DarkRed"
                   FontSize="16"
                   IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
